DISCORD_WEBHOOK_URL=

# Required by okx-strategy-bot when docker-compose starts it with --place-order.
# Use OKX Demo API credentials for the current code path.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional proxy settings for cloud hosts that need outbound proxy access.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# ALL_PROXY=http://host.docker.internal:7890
# NO_PROXY=127.0.0.1,localhost
