DISCORD_WEBHOOK_URL=

# Primary public market-data source for the web monitor.
# Supported values: gate, binance. The app automatically falls back to the other source.
MARKET_DATA_SOURCE=gate

# Required by okx-strategy-bot when docker-compose starts it with --place-order.
# Use OKX Demo API credentials for the current code path.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Set this when the OKX Demo account uses long/short dual-side position mode.
# Supported values: long_short, hedge, dual, dual_side.
OKX_POSITION_MODE=long_short

# Optional: max seconds allowed for one market-cap bot scan.
# If a scan exceeds this, the bot exits and Docker restart policy brings it back.
BOT_SCAN_TIMEOUT_SECONDS=300

# Optional self-use website monitor. No account portal or multi-tenant UI.
# Defaults check local /api/health, /api/reports, and /reports.html every 60s.
# SITE_MONITOR_ENABLED=true
# SITE_MONITOR_INTERVAL_SECONDS=60
# SITE_MONITOR_FAILURE_THRESHOLD=3
# SITE_MONITOR_TIMEOUT_SECONDS=8
# SITE_MONITOR_RECOVERY_NOTIFY=true
# SITE_MONITOR_TARGETS=health=http://127.0.0.1:8080/api/health,reports_api=http://127.0.0.1:8080/api/reports,reports_page=http://127.0.0.1:8080/reports.html
# SITE_MONITOR_MIN_REPORT_COUNT=0
# SITE_MONITOR_REPORT_MAX_AGE_SECONDS=0
# SITE_MONITOR_REQUIRE_OKX_BOT_FILES=false
# SITE_MONITOR_REQUIRE_OKX_BOT_OK=false

# Optional: override risk-based position sizing without editing config.yaml.
# BOT_RISK_PER_TRADE_PCT=0.005
# BOT_MAX_POSITION_NOTIONAL_USDT=50
# BOT_SIZING_EQUITY_USDT=0

# Optional proxy settings for cloud hosts that need outbound proxy access.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# ALL_PROXY=http://host.docker.internal:7890
# NO_PROXY=127.0.0.1,localhost
