DISCORD_WEBHOOK_URL=

# Optional long-running universe backtest notifications. Disabled by default.
# A dedicated webhook takes priority; when empty, DISCORD_WEBHOOK_URL is used.
BACKTEST_DISCORD_ENABLED=false
BACKTEST_DISCORD_WEBHOOK_URL=
BACKTEST_DISCORD_MIN_INTERVAL=900
# Public root used to turn reports/.../report.html into a Discord link.
REPORT_PUBLIC_BASE_URL=http://your-server.example.com

# Primary public market-data source for the web monitor.
# binance_usdm is live public futures data and never falls back to spot/Gate.
MARKET_DATA_SOURCE=binance_usdm

# Local paper tracking requires no exchange API keys.
FEISHU_AUTO_ENABLED=false

# Optional self-use website monitor. No account portal or multi-tenant UI.
# Defaults check local /api/health, /api/reports, and /reports.html every 60s.
# SITE_MONITOR_ENABLED=true
# SITE_MONITOR_INTERVAL_SECONDS=60
# SITE_MONITOR_FAILURE_THRESHOLD=3
# SITE_MONITOR_TIMEOUT_SECONDS=8
# SITE_MONITOR_RECOVERY_NOTIFY=true
# SITE_MONITOR_TARGETS=health=http://127.0.0.1:8080/api/health,reports_api=http://127.0.0.1:8080/api/reports,reports_page=http://127.0.0.1:8080/reports.html
# SITE_MONITOR_MIN_REPORT_COUNT=0
# SITE_MONITOR_REPORT_MAX_AGE_SECONDS=0

# Bounded JSONL and Docker runtime logs/resources.
# EVENT_LOG_MAX_BYTES=10485760
# EVENT_LOG_BACKUP_COUNT=5
# DOCKER_LOG_MAX_SIZE=10m
# DOCKER_LOG_MAX_FILES=3
# WEB_CPUS=1.0
# WEB_MEMORY_LIMIT=512m
# BACKTEST_CPUS=0.75
# BACKTEST_MEMORY_LIMIT=700m
# BACKTEST_MEMORY_SWAP_LIMIT=1200m

# Optional proxy settings for cloud hosts that need outbound proxy access.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# ALL_PROXY=http://host.docker.internal:7890
# NO_PROXY=127.0.0.1,localhost
